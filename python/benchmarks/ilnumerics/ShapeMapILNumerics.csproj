<Project Sdk="Microsoft.NET.Sdk">

  <!-- ILNumerics side of the viproc shape map (see README.md). Release builds
       run through the ILNumerics Accelerator (ILNAcceleratorEnabled defaults
       to true for Release, false for Debug). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ShapeMapILNumerics</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- The runtime license (ILNumerics_deploy/net8.0/ilnumerics.lic) is bound to the
         configuration it was made for, Release|x64: build x64 by default so that
         `dotnet build -c Release` embeds it. Output: bin/x64/Release/net8.0. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILNumerics.Computing" Version="7.4.62" />
  </ItemGroup>

</Project>
